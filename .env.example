# Keep previews unindexed. Set only on the bank's production deployment.
SITE_ENV=preview

# Server-only public CMS connection. No API secret is required.
CMS_URL=https://your-cms-host.example
BRAND_KEY=your-brand-key
# Public website origin for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-website.example
